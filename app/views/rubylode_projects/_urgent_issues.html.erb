<%# Open issues that are in progress or above the default priority; the rule is in RubylodeProjects::UrgencyRule. %>
<% project = overview.project %>
<% issues = overview.urgent_issues %>
<div class="rubylode-overview-card rubylode-overview-urgent">
  <div class="rubylode-overview-card-header">
    <h3><%= l(:rubylode_projects_in_progress_and_urgent) %> <span class="rubylode-overview-count"><%= number_with_delimiter(overview.urgent_issue_count) %></span></h3>
    <%= link_to l(:rubylode_projects_all_open_by_priority), project_issues_path(project, set_filter: 1, status_id: "o", sort: "priority:desc,updated_on:desc"),
                class: "rubylode-overview-header-link" %>
  </div>
  <% if issues.empty? %>
    <p class="rubylode-overview-empty"><%= l(:rubylode_projects_nothing_urgent) %></p>
  <% else %>
    <ul class="rubylode-overview-issue-list">
      <% issues.each do |issue| %>
        <li class="rubylode-overview-issue" data-issue-id="<%= issue.id %>">
          <%= link_to "##{issue.id}", issue_path(issue), class: "rubylode-overview-issue-number" %>
          <span class="rubylode-overview-chip rubylode-overview-status <%= overview.in_progress?(issue) ? 'is-in-progress' : 'is-waiting' %>"><%= issue.status.name %></span>
          <% if overview.urgent_priority?(issue) %>
            <span class="rubylode-overview-chip rubylode-overview-priority"><%= issue.priority.name %></span>
          <% end %>
          <span class="rubylode-overview-issue-subject">
            <% if issue.project_id != project.id %><span class="rubylode-overview-issue-project"><%= issue.project.name %></span><% end %>
            <%= link_to issue.subject, issue_path(issue) %>
          </span>
          <span class="rubylode-overview-issue-tracker"><%= issue.tracker.name %></span>
        </li>
      <% end %>
    </ul>
  <% end %>
</div>
