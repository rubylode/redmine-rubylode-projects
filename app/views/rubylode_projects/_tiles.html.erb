<%# Four tiles: open (split by tracker), closed (share of all), all (how many subprojects), done (a bar). %>
<% totals = overview.totals %>
<% project = overview.project %>
<% link = overview.issue_list_link(project_issues_path(project)) %>
<div class="rubylode-overview-tiles">
  <div class="rubylode-overview-card rubylode-overview-tile" data-rubylode-tile="open">
    <div class="rubylode-overview-tile-label"><%= l(:rubylode_projects_open_issues) %></div>
    <div class="rubylode-overview-tile-value"><%= link_to number_with_delimiter(totals.open_count), link.status(:open) %></div>
    <div class="rubylode-overview-tile-note">
      <%= safe_join(totals.open_by_tracker.map { |tally| "#{tally.tracker.name} #{number_with_delimiter(tally.open_count)}" }, " · ") %>
    </div>
  </div>
  <div class="rubylode-overview-card rubylode-overview-tile" data-rubylode-tile="closed">
    <div class="rubylode-overview-tile-label"><%= l(:rubylode_projects_closed_issues) %></div>
    <div class="rubylode-overview-tile-value"><%= link_to number_with_delimiter(totals.closed_count), link.status(:closed) %></div>
    <div class="rubylode-overview-tile-note"><%= l(:rubylode_projects_closed_share, percentage: totals.done_percentage) %></div>
  </div>
  <div class="rubylode-overview-card rubylode-overview-tile" data-rubylode-tile="all">
    <div class="rubylode-overview-tile-label"><%= l(:rubylode_projects_all_issues) %></div>
    <div class="rubylode-overview-tile-value"><%= link_to number_with_delimiter(totals.total_count), link.status(:all) %></div>
    <div class="rubylode-overview-tile-note">
      <%= overview.subproject_count.zero? ? l(:rubylode_projects_this_project_only) : l(:rubylode_projects_across_subprojects, count: overview.subproject_count) %>
    </div>
  </div>
  <div class="rubylode-overview-card rubylode-overview-tile" data-rubylode-tile="done">
    <div class="rubylode-overview-tile-label"><%= l(:rubylode_projects_done) %></div>
    <div class="rubylode-overview-tile-body">
      <div class="rubylode-overview-tile-value"><%= link_to "#{totals.done_percentage}%", link.status(:closed) %></div>
      <div class="rubylode-overview-meter rubylode-overview-meter-done" role="presentation">
        <div class="rubylode-overview-meter-fill rubylode-overview-progress" style="width: <%= totals.done_percentage %>%"></div>
      </div>
    </div>
    <div class="rubylode-overview-tile-note">
      <%= l(:rubylode_projects_closed_of_total, closed: number_with_delimiter(totals.closed_count), total: number_with_delimiter(totals.total_count)) %>
    </div>
  </div>
</div>
